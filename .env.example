# Application
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
POSTGRES_PORT=5432
DATABASE_URL=postgresql://csr:csr_local_dev_password@localhost:5432/csr
APP_TIME_ZONE=Asia/Shanghai
PORT=3000

# Anonymous visitor identity
VISITOR_COOKIE_NAME=__Host-csr_visitor
VISITOR_COOKIE_MAX_AGE_DAYS=365
VISITOR_TOKEN_HASH_PEPPER=replace-with-at-least-32-random-characters
IP_HMAC_SECRET=replace-with-a-different-32-character-secret
ADMIN_SESSION_SECRET=replace-with-another-32-character-secret
ADMIN_SESSION_COOKIE_NAME=__Host-csr_admin
ADMIN_SESSION_TTL_HOURS=12
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# Edition bootstrap defaults; the persisted Edition becomes the runtime source of truth.
ACTIVE_EDITION_CODE=2026
DEFAULT_FULL_WEIGHT_BALLOTS_PER_DAY=50
DEFAULT_BALLOT_TTL_MINUTES=30
ACTIVE_POOL_CACHE_TTL_SECONDS=60
BALLOT_NEXT_RATE_LIMIT_PER_MINUTE=30
BALLOT_RESOLVE_RATE_LIMIT_PER_MINUTE=60
RATE_LIMITER_MAX_KEYS=10000
RISK_ENFORCEMENT_MODE=observe
IP_RISK_KEY_RETENTION_DAYS=90
PRODUCT_EVENT_RETENTION_DAYS=90

# Proxy/IP risk configuration
CLIENT_IP_MODE=railway
TRUST_PROXY_HEADERS=false

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# External data remains disabled until the Milestone 7 adapter work.
HLTV_SYNC_ENABLED=false
HLTV_REQUEST_DELAY_MS=3000
HLTV_USER_AGENT=
VRS_SOURCE_URL=https://github.com/ValveSoftware/counter-strike_regional_standings
