{
  "name": "cs-community-ranking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community-generated Counter-Strike professional-player ranking.",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.16.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.mjs --configLoader runner",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/seed.ts",
    "db:seed:staging": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/staging-bootstrap.ts",
    "db:check": "node --env-file=.env node_modules/drizzle-kit/bin.cjs check",
    "admin:create": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/admin-create.ts",
    "pool:add-player": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/pool-add-player.ts",
    "pool:admit-review-manual": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/pool-admit-review-manual-teams.ts",
    "pool:admit-special-retired": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/pool-admit-special-retired.ts",
    "pool:disable-player": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/pool-disable-player.ts",
    "score:check": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/score-check.ts",
    "job:sync-vrs": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-sync-vrs.ts",
    "job:sync-hltv": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-sync-hltv.ts",
    "source:import-reviewed-hltv": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/import-reviewed-hltv-ranking.ts",
    "source:import-reviewed-hltv-stats": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/import-reviewed-hltv-player-stats.ts",
    "source:import-reviewed-career-rating": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/import-reviewed-career-ratings.ts",
    "source:create-reviewed-hltv-stats-template": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/create-reviewed-hltv-player-stats-template.ts",
    "source:capture-reviewed-hltv-stats": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/capture-reviewed-hltv-player-stats.ts",
    "source:preview-reviewed-hltv-stats": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/preview-reviewed-hltv-player-stats.ts",
    "source:approve-ranking": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/approve-ranking-source.ts",
    "pending:review": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/review-pending-imports.ts",
    "job:build-pool-draft": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-build-pool-draft.ts",
    "pool:build-draft": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-build-pool-draft.ts",
    "job:snapshot-ranking": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-snapshot-ranking.ts",
    "job:integrity-check": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-integrity-check.ts",
    "job:expire-ballots": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-expire-ballots.ts",
    "job:retention-cleanup": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/job-retention-cleanup.ts",
    "report:kpi": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/report-kpi.ts",
    "launch:check": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/launch-readiness.ts",
    "canonical:bootstrap": "node --env-file-if-exists=.env --import ./scripts/register-path-aliases.mjs scripts/canonical-bootstrap.ts",
    "ops:smoke": "node scripts/staging-smoke.ts",
    "ops:load": "node scripts/staging-load.ts",
    "backup:create": "node --env-file-if-exists=.env scripts/backup-create.ts",
    "backup:verify": "node --env-file-if-exists=.env scripts/backup-verify.ts",
    "assets:check": "node scripts/assets-check.ts",
    "assets:import-hltv-portraits": "node scripts/import-hltv-portrait-bundles.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
